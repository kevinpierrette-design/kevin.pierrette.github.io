  let dragging = false, sx, sy, sl, st;
  wrap.addEventListener('mousedown', e => {
    dragging = true; wrap.style.cursor = 'grabbing';
    sx = e.pageX - wrap.offsetLeft; sy = e.pageY - wrap.offsetTop;
    sl = wrap.scrollLeft; st = wrap.scrollTop;
  });
  window.addEventListener('mouseup', () => { dragging = false; if(wrap) wrap.style.cursor = 'grab'; });
  wrap.addEventListener('mousemove', e => {
    if (!dragging) return;
    wrap.scrollLeft = sl - (e.pageX - wrap.offsetLeft - sx);
    wrap.scrollTop = st - (e.pageY - wrap.offsetTop - sy);
  });
})();
</script>

