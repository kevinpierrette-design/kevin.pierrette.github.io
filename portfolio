<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kevin Pierrette - Portfolio BTS SIO</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
:root{
  --bg:#080810;--bg2:#0d0d1a;--bg3:#121220;
  --accent:#ec4899;--accent2:#f472b6;--accent3:#fbcfe8;
  --text:#fff0f8;--muted:#b0a0b8;
  --border:rgba(236,72,153,0.25);--card:rgba(10,8,18,0.88);
}
html{scroll-behavior:smooth}
body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--text);overflow-x:hidden}

/* NAV */
nav{position:fixed;top:0;width:100%;z-index:100;padding:.9rem 2.5rem;display:flex;justify-content:space-between;align-items:center;background:rgba(9,9,14,0.88);backdrop-filter:blur(18px);border-bottom:1px solid var(--border)}
.nav-logo{font-family:'Syne',sans-serif;font-weight:800;font-size:1.2rem;background:linear-gradient(135deg,var(--accent),var(--accent3));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.nav-links{display:flex;gap:1.8rem}
.nav-links a{color:var(--muted);text-decoration:none;font-size:.88rem;font-weight:500;transition:color .2s}
.nav-links a:hover{color:var(--accent2)}

/* HERO */
#hero{min-height:100vh;position:relative;z-index:1;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:7rem 2rem 4rem;position:relative;overflow:hidden}
.hero-glow{position:absolute;width:700px;height:700px;border-radius:50%;background:radial-gradient(circle,rgba(236,72,153,0.15) 0%,rgba(59,130,246,0.08) 50%,transparent 70%);top:50%;left:50%;transform:translate(-50%,-50%);pointer-events:none}
.hero-badge{display:inline-block;background:rgba(236,72,153,0.12);border:1px solid rgba(236,72,153,0.4);color:var(--accent2);font-size:.78rem;font-weight:500;padding:.4rem 1.1rem;border-radius:999px;margin-bottom:1.5rem;letter-spacing:.06em}
.hero-name{font-family:'Syne',sans-serif;font-size:clamp(3rem,9vw,6.5rem);font-weight:800;line-height:1.02;margin-bottom:.6rem}
.
.hero-title{font-size:clamp(1rem,2.5vw,1.3rem);color:var(--muted);font-weight:300;margin-bottom:.4rem}
.hero-title strong{color:var(--accent2);font-weight:500}
.hero-sub{font-size:.9rem;color:#6060a0;margin-bottom:2rem}
.hero-desc{max-width:560px;font-size:1rem;color:var(--muted);line-height:1.85;margin-bottom:2.5rem}
.hero-btns{display:flex;gap:1rem;flex-wrap:wrap;justify-content:center}
.btn-primary{background:linear-gradient(135deg,var(--accent),#8b5cf6);color:#fff;border:none;padding:.75rem 2rem;border-radius:8px;box-shadow:0 4px 24px rgba(236,72,153,0.35);font-family:'DM Sans',sans-serif;font-size:.93rem;font-weight:500;cursor:pointer;transition:opacity .2s,transform .2s;text-decoration:none;display:inline-block}
.btn-primary:hover{opacity:.85;transform:translateY(-2px)}
.btn-outline{background:transparent;color:var(--text);border:1px solid var(--border);padding:.75rem 2rem;border-radius:8px;font-family:'DM Sans',sans-serif;font-size:.93rem;font-weight:500;cursor:pointer;transition:border-color .2s,transform .2s;text-decoration:none;display:inline-block}
.btn-outline:hover{border-color:var(--accent);transform:translateY(-2px);box-shadow:0 0 20px rgba(236,72,153,0.2)}

/* SECTIONS */
.wrap{padding:5rem 2rem;max-width:940px;margin:0 auto;position:relative;z-index:1}
.section-label{font-size:.72rem;font-weight:500;letter-spacing:.18em;color:var(--accent);text-transform:uppercase;margin-bottom:.4rem}
.section-title{font-family:'Syne',sans-serif;font-size:clamp(1.7rem,4vw,2.4rem);font-weight:800;margin-bottom:1rem}
.section-line{width:44px;height:3px;background:linear-gradient(90deg,var(--accent),#a78bfa);border-radius:2px;margin-bottom:2.5rem}
.divider{width:100%;height:1px;background:var(--border);position:relative;z-index:1}

/* ABOUT */
.about-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:2.5rem;align-items:start}
.about-text{font-size:.97rem;color:#c0c0d8;line-height:1.9}
.about-text strong{color:var(--text)}
.about-text em{color:var(--accent2);font-style:normal;font-weight:500}
.about-stats{display:grid;grid-template-columns:1fr 1fr;gap:.9rem}
.stat-card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:1.2rem;text-align:center;transition:border-color .2s}
.stat-card:hover{border-color:var(--accent)}
.stat-card .num{font-family:'Syne',sans-serif;font-size:1.6rem;font-weight:800;color:var(--accent2);line-height:1.1}
.stat-card .lbl{font-size:.75rem;color:var(--muted);margin-top:5px;line-height:1.4}
.qualites{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1.2rem}
.q-tag{background:rgba(236,72,153,0.1);border:1px solid rgba(236,72,153,0.25);color:var(--accent2);font-size:.78rem;padding:.3rem .8rem;border-radius:999px}

/* PARCOURS TIMELINE */
.parcours-timeline{position:relative;padding-left:2rem}
.parcours-timeline::before{content:'';position:absolute;left:6px;top:0;bottom:0;width:2px;background:linear-gradient(180deg,var(--accent),rgba(236,72,153,0.1))}
.parcours-item{position:relative;margin-bottom:2.5rem}
.parcours-item:last-child{margin-bottom:0}
.parcours-dot{position:absolute;left:-2rem;top:4px;width:14px;height:14px;border-radius:50%;background:var(--accent);border:2px solid var(--bg);box-shadow:0 0 0 3px rgba(249,115,22,0.25)}
.parcours-year{font-size:.72rem;font-weight:600;color:var(--accent);letter-spacing:.1em;text-transform:uppercase;margin-bottom:.3rem}
.parcours-card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:1.3rem 1.5rem;transition:border-color .2s}
.parcours-card:hover{border-color:rgba(249,115,22,0.4)}
.parcours-title{font-family:'Syne',sans-serif;font-weight:700;font-size:1rem;margin-bottom:.25rem}
.parcours-sub{font-size:.85rem;color:var(--accent2);font-weight:500;margin-bottom:.5rem}
.parcours-desc{font-size:.87rem;color:var(--muted);line-height:1.75}
.parcours-tags{display:flex;flex-wrap:wrap;gap:.35rem;margin-top:.75rem}
.ptag{font-size:.68rem;padding:.2rem .6rem;border-radius:5px;background:rgba(236,72,153,0.08);border:1px solid rgba(236,72,153,0.2);color:var(--accent2)}

/* STAGES */
.stages-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.2rem}
.stage-card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:1.4rem;transition:border-color .2s,transform .2s;position:relative;overflow:hidden}
.stage-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--accent),#a78bfa);opacity:0;transition:opacity .2s}
.stage-card:hover{border-color:var(--accent);transform:translateY(-3px)}
.stage-card:hover::before{opacity:1}
.stage-year{font-size:.72rem;font-weight:500;letter-spacing:.1em;color:var(--accent);text-transform:uppercase;margin-bottom:.5rem}
.stage-company{font-family:'Syne',sans-serif;font-weight:700;font-size:1.05rem;margin-bottom:.25rem}
.stage-role{font-size:.85rem;color:var(--accent2);margin-bottom:.5rem;font-weight:500}
.stage-detail{font-size:.82rem;color:var(--muted);line-height:1.65}

/* REALISATIONS */
.real-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:1.1rem}
.real-card{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:1.2rem;transition:border-color .2s}
.real-card:hover{border-color:rgba(249,115,22,0.4)}
.real-tag{display:inline-block;background:rgba(236,72,153,0.1);color:var(--accent2);font-size:.7rem;padding:.2rem .65rem;border-radius:999px;margin-bottom:.6rem;font-weight:500}
.real-name{font-weight:500;font-size:.92rem;margin-bottom:.3rem;line-height:1.4}
.real-badges{display:flex;flex-wrap:wrap;gap:.3rem;margin-top:.5rem}
.badge{font-size:.65rem;padding:.2rem .5rem;border-radius:4px;background:rgba(255,255,255,0.05);color:var(--muted);border:1px solid rgba(255,255,255,0.07)}

/* COMPETENCES */
.skills-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:1rem}
.skill-card{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:1.2rem;transition:border-color .2s,transform .2s}
.skill-card:hover{border-color:var(--accent);transform:translateY(-3px)}
.skill-icon{font-size:1.4rem;margin-bottom:.65rem}
.skill-name{font-weight:500;font-size:.9rem;margin-bottom:.5rem}
.skill-pct{font-size:.75rem;color:var(--muted);margin-bottom:.4rem;text-align:right}
.skill-bar{height:4px;border-radius:2px;background:rgba(255,255,255,0.07);overflow:hidden}
.skill-fill{height:100%;background:linear-gradient(90deg,var(--accent),#a78bfa);border-radius:2px}

/* CERTIFICATIONS placeholder */
.cert-placeholder{background:var(--card);border:2px dashed rgba(249,115,22,0.3);border-radius:16px;padding:3rem 2rem;text-align:center}
.cert-placeholder .icon{font-size:2.5rem;margin-bottom:1rem;opacity:.5}
.cert-placeholder p{color:var(--muted);font-size:.95rem;line-height:1.7}
.cert-placeholder strong{color:var(--accent2)}

/* VEILLE */
.veille-box{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:2rem;display:grid;grid-template-columns:1fr 1fr;gap:2rem;align-items:start}
.veille-title{font-family:'Syne',sans-serif;font-weight:700;font-size:1.05rem;margin-bottom:.5rem}
.veille-desc{font-size:.88rem;color:var(--muted);line-height:1.8}
.veille-tags{display:flex;flex-wrap:wrap;gap:.4rem;margin-top:.9rem}
.vtag{background:rgba(236,72,153,0.1);border:1px solid rgba(236,72,153,0.25);color:var(--accent2);font-size:.74rem;padding:.25rem .7rem;border-radius:6px}
.veille-link{display:inline-flex;align-items:center;gap:.4rem;margin-top:1.1rem;color:var(--accent2);font-size:.84rem;text-decoration:none;font-weight:500;border:1px solid var(--border);padding:.5rem 1rem;border-radius:8px;transition:border-color .2s}
.veille-link:hover{border-color:var(--accent)}

/* CONTACT */
.contact-box{background:var(--card);border:1px solid var(--border);border-radius:20px;padding:3rem 2.5rem;text-align:center}
.contact-box p{color:var(--muted);margin-bottom:2rem;line-height:1.8;max-width:500px;margin-left:auto;margin-right:auto;margin-bottom:2rem}
.contact-links{display:flex;gap:.9rem;justify-content:center;flex-wrap:wrap}
.contact-chip{display:flex;align-items:center;gap:.5rem;background:rgba(236,72,153,0.08);border:1px solid var(--border);color:var(--text);font-size:.88rem;padding:.6rem 1.25rem;border-radius:999px;text-decoration:none;transition:background .2s,border-color .2s}
.contact-chip:hover{background:rgba(236,72,153,0.2);border-color:var(--accent)}
.contact-info{margin-top:1.5rem;display:flex;gap:1.5rem;justify-content:center;flex-wrap:wrap}
.cinfo{font-size:.85rem;color:var(--muted)}
.cinfo strong{color:var(--accent2)}

footer{position:relative;z-index:1;text-align:center;padding:2rem;color:var(--muted);font-size:.82rem;border-top:1px solid var(--border)}

@keyframes fadeUp{from{opacity:0;transform:translateY(28px)}to{opacity:1;transform:translateY(0)}}
.fu{animation:fadeUp .65s ease forwards}
.d1{animation-delay:.1s;opacity:0}.d2{animation-delay:.25s;opacity:0}.d3{animation-delay:.4s;opacity:0}.d4{animation-delay:.55s;opacity:0}.d5{animation-delay:.7s;opacity:0}

@media(max-width:640px){
  .about-grid,.veille-box{grid-template-columns:1fr}
  .nav-links{gap:1rem;font-size:.78rem}
  nav{padding:.9rem 1.2rem}
  .wrap{padding:3.5rem 1.2rem}
}

/* AVATAR */
.hero-avatar {
  width: 120px; height: 120px;
  border-radius: 50%;
  overflow: hidden;
  border: 3px solid var(--accent);
  box-shadow: 0 0 0 6px rgba(236,72,153,0.2), 0 0 40px rgba(236,72,153,0.15);
  margin-bottom: 1.2rem;
}
.hero-avatar img {
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: center top;
}

/* PHONE ISLAND */
.phoneisland-grid{display:grid;grid-template-columns:1fr 1fr;gap:2rem;align-items:start}
.pi-desc-card{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:1.8rem}
.pi-logo{font-size:2.5rem;margin-bottom:.75rem}
.pi-title{font-family:'Syne',sans-serif;font-weight:800;font-size:1.4rem;margin-bottom:.2rem}
.pi-subtitle{font-size:.85rem;color:var(--accent2);font-weight:500;margin-bottom:1rem}
.pi-text{font-size:.9rem;color:var(--muted);line-height:1.8;margin-bottom:1.1rem}
.pi-services{display:flex;flex-wrap:wrap;gap:.45rem}
.pi-tag{background:rgba(236,72,153,0.1);border:1px solid rgba(236,72,153,0.25);color:var(--accent2);font-size:.75rem;padding:.3rem .75rem;border-radius:999px}
.pi-flyers-placeholder{background:var(--card);border:2px dashed rgba(249,115,22,0.3);border-radius:16px;padding:2.5rem 1.5rem;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:200px}
.flyer-ph-icon{font-size:2.5rem;margin-bottom:1rem;opacity:.5}
.flyer-ph-text{color:var(--muted);font-size:.9rem;line-height:1.7}
.flyer-ph-text strong{color:var(--accent2)}
@media(max-width:640px){.phoneisland-grid{grid-template-columns:1fr}}

/* CV */
.cv-container{display:flex;flex-direction:column;gap:1.5rem}
.cv-header{display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap}
.cv-desc{color:var(--muted);font-size:.95rem}
.cv-viewer{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:1rem;overflow:hidden}

/* HOVER TEXT SCALE */
.parcours-title, .parcours-desc,
.stage-company, .stage-role, .stage-detail,
.real-name,
.skill-name,
.section-title,
.pi-title, .pi-text,
.veille-title, .veille-desc,
.about-text p,
.stat-card .num, .stat-card .lbl,
.hero-title, .hero-desc,
footer p {
  display: inline-block;
  transition: transform 0.2s ease, color 0.2s ease;
  cursor: default;
}

.parcours-title:hover, .stage-company:hover, .real-name:hover,
.skill-name:hover, .pi-title:hover, .veille-title:hover {
  transform: scale(1.04);
  color: var(--accent2);
}

.parcours-desc:hover, .stage-role:hover, .stage-detail:hover,
.veille-desc:hover, .pi-text:hover, .about-text p:hover {
  transform: scale(1.02);
}

.stat-card .num:hover {
  transform: scale(1.12);
  color: var(--accent3);
}

.section-title:hover {
  transform: scale(1.03);
  color: var(--accent2);
}

.hero-title:hover {
  transform: scale(1.03);
  color: var(--accent2);
}

.hero-desc:hover {
  transform: scale(1.01);
}







/* SHINE */
@keyframes shine{
  0%   { background-position: -200% center; }
  50%  { background-position: 200% center; }
  50.01% { background-position: -200% center; }
  100% { background-position: -200% center; }
}
.hero-name span{
  background:linear-gradient(90deg,#fff 0%,var(--accent3) 15%,var(--accent2) 30%,#fff 50%,var(--accent) 70%,var(--accent3) 85%,#fff 100%);
  background-size:200% auto;
  -webkit-background-clip:text;
  -webkit-text-fill-color:transparent;
  background-clip:text;
  animation:shine 10s linear infinite;
  display:inline;
}



/* VEGETAL BACKGROUND */
body {
  background: #080810;
}
body::after {
  content: '';
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background-image: url('data:image/jpeg;base64,');
  background-size: cover;
  background-position: center top;
  background-attachment: fixed;
  opacity: 0.18;
  pointer-events: none;
  z-index: 0;
  filter: blur(1px) saturate(1.2) brightness(0.6);
}


/* LUXURY OVERLAY */
body::before {
  content: '';
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: 
    radial-gradient(ellipse at 20% 20%, rgba(236,72,153,0.1) 0%, transparent 50%),
    radial-gradient(ellipse at 80% 80%, rgba(139,92,246,0.07) 0%, transparent 50%);
  pointer-events: none;
  z-index: 0;
}
nav{background:rgba(8,8,16,0.92);border-bottom:1px solid rgba(236,72,153,0.2);backdrop-filter:blur(20px);}

/* TABLEAU DE SYNTHESE */
.synth-info{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:.8rem;margin-bottom:2rem}
.synth-info-card{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:1rem;display:flex;flex-direction:column;gap:.3rem}
.synth-label{font-size:.72rem;color:var(--muted);text-transform:uppercase;letter-spacing:.08em}
.synth-value{font-size:.95rem;font-weight:500;color:var(--accent2)}

.synth-legend{display:flex;flex-wrap:wrap;gap:.6rem;margin-bottom:2rem;padding:1rem;background:var(--card);border:1px solid var(--border);border-radius:12px}
.leg-item{display:flex;align-items:center;gap:.4rem;font-size:.75rem;color:var(--muted)}
.leg-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0}
.leg-dot.c1{background:#ec4899}
.leg-dot.c2{background:#a78bfa}
.leg-dot.c3{background:#34d399}
.leg-dot.c4{background:#60a5fa}
.leg-dot.c5{background:#fbbf24}
.leg-dot.c6{background:#f87171}

.synth-group{margin-bottom:2rem}
.synth-group-title{font-family:'Syne',sans-serif;font-weight:700;font-size:1rem;color:var(--accent2);margin-bottom:1rem;padding-bottom:.5rem;border-bottom:1px solid var(--border)}
.synth-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:.8rem}
.synth-card{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:1rem 1.2rem;transition:border-color .2s,transform .2s;display:flex;flex-direction:column;gap:.6rem}
.synth-card:hover{border-color:var(--accent);transform:translateY(-2px)}
.synth-card-name{font-size:.88rem;font-weight:500;color:var(--text);line-height:1.5}
.synth-badges{display:flex;flex-wrap:wrap;gap:.35rem}
.sb{font-size:.68rem;font-weight:700;padding:.2rem .55rem;border-radius:5px;letter-spacing:.05em}
.sb.c1{background:rgba(236,72,153,0.15);color:#ec4899;border:1px solid rgba(236,72,153,0.3)}
.sb.c2{background:rgba(167,139,250,0.15);color:#a78bfa;border:1px solid rgba(167,139,250,0.3)}
.sb.c3{background:rgba(52,211,153,0.15);color:#34d399;border:1px solid rgba(52,211,153,0.3)}
.sb.c4{background:rgba(96,165,250,0.15);color:#60a5fa;border:1px solid rgba(96,165,250,0.3)}
.sb.c5{background:rgba(251,191,36,0.15);color:#fbbf24;border:1px solid rgba(251,191,36,0.3)}
.sb.c6{background:rgba(248,113,113,0.15);color:#f87171;border:1px solid rgba(248,113,113,0.3)}
.synth-dl{text-align:center;margin-top:2rem}


